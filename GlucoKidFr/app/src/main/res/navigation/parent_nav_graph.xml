<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_nav_graph"
    app:startDestination="@id/childrenListFragment">
    <fragment
    android:id="@+id/addChildFragment"
    android:name="com.example.glucokidfr.ui.addChildScreen.AddChildFragment"
    android:label="Добавить ребенка"
    tools:layout="@layout/add_child_screen">
    <action
        android:id="@+id/action_addChildFragment_to_childrenListFragment"
        app:destination="@id/childrenListFragment"
        app:popUpTo="@id/addChildFragment"
        app:popUpToInclusive="true" />
</fragment>

    <fragment
        android:id="@+id/homeParentFragment"
        android:name="com.example.glucokidfr.ui.homeParent.HomeParentFragment"
        android:label="Главная"
        tools:layout="@layout/home_screen_parent" />

    <fragment
        android:id="@+id/scheduleFragment"
        android:name="com.example.glucokidfr.ui.schedule.ScheduleFragment"
        android:label="Расписание"
        tools:layout="@layout/schedule"/>
    <fragment
        android:id="@+id/childrenListFragment"
        android:name="com.example.glucokidfr.ui.childrenList.ChildrenListFragment"
        android:label="Список детей"
        tools:layout="@layout/fragment_children_list" >
        <action
            android:id="@+id/action_childrenListFragment_to_addChildFragment"
            app:destination="@id/addChildFragment" />
    </fragment>
    <fragment
        android:id="@+id/parentSettingsFragment"
        android:name="com.example.glucokidfr.ui.parentSettings.ParentSettingsFragment"
        android:label="Настройки"
        tools:layout="@layout/settings_parent" />
</navigation>